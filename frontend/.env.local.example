# Frontend 환경변수 예시
# 이 파일을 .env.local로 복사하여 사용하세요

# Supabase 설정
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API/WS 기본 설정
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# 라이브 영상-자막 동기화 (2026-09-03 정정 — 아래 값은 전부 빌드 시 인라인된다)
# 영상을 라이브 엣지에서 일부러 늦추는 초. 자막 준비 지연(stt_status.ready_lag_p95)+수집 3초+여유 2초.
# 현장에서는 /live?sync=N 으로 세션 한정 덮어쓰기 가능. 기본값은 HlsPlayer.tsx 참조.
# NEXT_PUBLIC_LIVE_SYNC_SEC=20   # 폴백 — 실제 목표는 서버(api env LIVE_SYNC_TARGET_SEC, 채널 상태 응답)가 준다(2026-09-14)
# 동기화 **실패 시 폴백** 고정 지연(ms). 정밀 동기화가 성립하면 쓰이지 않는다. 기본 5000.
# NEXT_PUBLIC_SUBTITLE_DISPLAY_DELAY_MS=5000

# 브라우저 마이크 오디오 업링크 WebSocket (서버 STT ingress)
NEXT_PUBLIC_STT_STREAM_WS_URL=ws://localhost:8000

# 개발/데모용 fallback mock 모드 (true면 서버 키 없어도 가짜 partial/final 생성)
NEXT_PUBLIC_STT_MOCK_MODE=false

# 참고: 실제 STT provider 키/리전/엔드포인트는 서버(.env)에서 관리
# STT_API_KEY=your-secret-key
# STT_REGION=ap-northeast-2
