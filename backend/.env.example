# Backend 환경변수 예시
# 이 파일을 .env로 복사하여 사용하세요.
#   cp backend/.env.example backend/.env

# Supabase 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# 데이터베이스 (Supabase PostgreSQL) — 직접 DDL/마이그레이션 시에만 사용
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# OpenAI (STT 전면 교체 — Deepgram 제거됨, Phase 12. 2026-09-03 현행화)
#   - 라이브 전사(운영): live_stt_mode=batch — 12초 창을 gpt-4o-transcribe 배치로 (live_batch_stt.py)
#     (Realtime WS 경로 gpt-realtime-whisper 는 비활성 분기)
#   - 라이브 사후 교정: gpt-5.4-mini (4건/7초)
#   - VOD 배치: whisper-1(타임스탬프) — diarize 는 기본 OFF
#   - 문법/요약 등: openai_model (기본 gpt-5.4-mini)
# 모델명은 backend/app/core/config.py 에서 override 가능.
OPENAI_API_KEY=sk-...

# VOD 새벽 자동 점검 + AI 자막 자동 생성 (2026-09-03) — 회의당 ~$0.4, 하루 상한 10건
VOD_AUTO_STT_ENABLED=true
VOD_AUTO_STT_HOUR_KST=7
VOD_AUTO_STT_DAILY_LIMIT=10
VOD_AUTO_STT_MAX_AGE_DAYS=3
# KMS 자동 등록 주기(분) — 등록만, AI 비용 0
KMS_AUTO_REGISTER_INTERVAL_MINUTES=60

# JWT 인증 — 프로덕션에서는 반드시 새로 발급
#   생성 예: openssl rand -hex 32
# 필수. 비우면 서버가 기동하지 않는다. 생성: openssl rand -hex 32
JWT_SECRET_KEY=

# CORS 허용 도메인 (JSON 배열 형식)
#   프로덕션: ["https://ggcsubai.vercel.app"]
#   개발: ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# STT 자동 시작 (방송중 채널 감지 시 자동 STT)
#   라이브 전사를 띄우려면 true. 로컬 스모크 부팅 시엔 false로 비용 방지.
STT_AUTO_START=true

# 디버그 모드 (프로덕션에서는 false)
DEBUG=false

# (선택) Supabase Management API로 마이그레이션 적용 시 — scripts/apply_migrations_api.py
#   계정 Personal Access Token(sbp_...). 절대 커밋 금지.
# SUPABASE_ACCESS_TOKEN=sbp_...
