# ─────────────────────────────────────────────────────────────────────────────
# 실시간 자막 서비스 — 백엔드 환경변수 예시
#   cp backend/.env.example backend/.env
#
# 설치 순서와 최소 구성은 docs/SETUP.md 를 보세요.
# 항목 이름은 backend/app/core/config.py 의 필드명을 대문자로 한 것입니다.
# ⚠ 정의되지 않은 이름은 **조용히 버려집니다**(pydantic extra="ignore") — 오타가 경고를 내지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ 1. 반드시 채워야 하는 것 ═══════════════════════════════════════════════

# OpenAI — 자막(STT)·요약·교정이 전부 이 키 하나를 씁니다.
#   비용 감각: 생중계 1채널 1시간 ≈ $0.4. OpenAI 콘솔에서 **월 한도**를 꼭 거세요.
OPENAI_API_KEY=sk-...

# JWT 서명키 — 비우면 토큰을 누구나 위조할 수 있습니다.
#   생성: openssl rand -hex 32
JWT_SECRET_KEY=

# DB — 이 서비스는 PostgREST 를 통해 PostgreSQL 에 붙습니다.
#   라이브러리가 supabase-py 일 뿐, Supabase 클라우드가 아니어도 됩니다(자체 PostgREST 로 완결).
SUPABASE_URL=http://localhost:8080
SUPABASE_KEY=
# ★스키마를 안 맞추면 **모든 쿼리가 406(PGRST106)** 으로 죽습니다. 실제 장애로 겪은 항목입니다.
SUPABASE_SCHEMA=public
# 마이그레이션·DDL 을 직접 돌릴 때만 씁니다(런타임 쿼리는 위 PostgREST 를 탑니다).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# 관리 기능 앞의 PIN. 비우면 PIN 로그인이 꺼집니다.
#   ⚠ 쿠버네티스 매니페스트가 이 값을 Secret 으로 참조합니다 — 없으면 파드가 뜨지 않습니다.
ADMIN_QUICK_PIN=

# CORS 허용 출처 (JSON 배열)
CORS_ORIGINS=["http://localhost:3000"]

# ═══ 2. 기관(테넌트) 설정 — 다른 의회는 여기만 바꾸면 됩니다 ════════════════
# 값을 **비우면 그 기능이 조용히 꺼집니다.** 자막·검색·요약은 계속 동작합니다.

# 화면과 전사 프롬프트에 쓰는 기관 이름
ORG_NAME=우리 의회

# 영상관리시스템(다시보기·속기록·안건·클립의 원본). 없으면 비웁니다.
KMS_BASE_URL=

# 의사일정(의정캘린더) 수집 주소. 없으면 비웁니다.
COUNCIL_CALENDAR_URL=

# 의원 명부 API. 없으면 비웁니다.
#   ⚠ 명부가 비면 자막은 나오지만 **화자 이름이 안 붙습니다**(전부 "위원장" 으로 굳습니다).
COUNCILOR_API_BASE_URL=

# 기관 생중계 상태 API (채널의 status_provider=ggc 일 때만). 없으면 비웁니다.
COUNCIL_ONAIR_API_URL=

# 모바일 앱 QR 로그인 상류. 없으면 QR 로그인 버튼이 사라집니다.
GGC_LOGIN_BASE_URL=

# ═══ 3. 채널과 방송 감지 ═══════════════════════════════════════════════════
# 채널은 DB 표(subtitle.channels)에서 오고 /admin/channels 화면에서 등록합니다.
#   db   = 표를 읽는다(기본)
#   seed = 표를 무시하고 코드에 든 시드로 돈다(전환 사고 시 되돌리는 킬스위치)
CHANNELS_SOURCE=db
CHANNELS_CACHE_TTL_SECONDS=60
# 다른 기관 배포에서는 false 를 권합니다 — DB 를 못 읽을 때 남의 채널이 뜨지 않게.
CHANNELS_SEED_FALLBACK=true

# 채널에 값이 없을 때 쓰는 방송 판정 방식: probe | ggc | manual | none
#   probe  = 영상 주소(m3u8)를 직접 받아 세그먼트가 늘면 방송중 (기관 중립 — 권장)
#   ggc    = 기관 생중계 API 를 읽는다
#   manual = 관리자가 화면에서 켜고 끈다
DEFAULT_STATUS_PROVIDER=probe
PROBE_INTERVAL_SECONDS=20
PROBE_STALE_SECONDS=60
PROBE_OFF_SECONDS=300

# 등록된 채널 호스트 외에 추가로 허용할 스트림 호스트 (콤마 구분)
EXTRA_STREAM_HOSTS=

# 생중계 페이지에서 영상 주소 자동 찾기 (관리자 전용)
DISCOVERY_ENABLED=true

# ═══ 4. STT·비용 가드 ══════════════════════════════════════════════════════
# 방송중인 채널을 자동으로 전사할지
STT_AUTO_START=true
# ★동시에 전사할 채널 수 상한 — **이것이 실질적인 비용 상한입니다.**
STT_MAX_CONCURRENT_CHANNELS=14
# 라이브 전사 방식: batch(권장) | realtime
LIVE_STT_MODE=batch
# 라이브 전사 모델. 계정에 권한이 없는 모델명을 넣으면 **자막만 조용히 안 나옵니다**
# (관리자 화면의 OpenAI 상태는 "정상" 으로 보입니다 — 모델 목록 조회만 하기 때문입니다).
LIVE_BATCH_MODEL=gpt-4o-transcribe
LIVE_BATCH_WINDOW_SECONDS=12
# 영상-자막 동기화 목표(초). /live 가 영상을 이만큼 뒤로 늦춰 재생합니다.
LIVE_SYNC_TARGET_SEC=20

# 요약·대화·안건 추출 모델
OPENAI_MODEL=gpt-5.4-mini
SUMMARY_MODEL=gpt-5.5
AGENDA_MODEL=gpt-5.4

# 다시보기 자동 자막 생성 (KMS_BASE_URL 이 있어야 의미가 있습니다)
VOD_AUTO_STT_ENABLED=true
VOD_AUTO_STT_DAILY_LIMIT=10
VOD_AUTO_STT_MAX_AGE_DAYS=3

# ═══ 5. 그 밖 ══════════════════════════════════════════════════════════════
# 비로그인 방문자에게 발언영상·AI 를 여는 기관 내부망 대역 (비우면 아무에게도 안 엽니다)
#   ★실제 대역 값을 저장소에 넣지 마세요. 운영은 ConfigMap/환경변수로만 줍니다.
COUNCIL_NETWORK_RANGES=
# 통합 로그인(SSO) 내부 주소. 비우면 SSO 만 꺼지고 나머지 로그인은 삽니다.
GGC_SSO_INTERNAL_URL=
# 파일 다운로드 절대주소를 만들 때 쓰는 공개 주소
PUBLIC_BASE_URL=
DEBUG=false
