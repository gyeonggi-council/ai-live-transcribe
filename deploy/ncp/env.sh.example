# =============================================================================
#  배포 대상 좌표 — 저장소에 넣지 않는 값
#
#    cp deploy/ncp/env.sh.example deploy/ncp/env.sh   후 실제 값을 채운다.
#    env.sh 는 .gitignore 에 있다.
#
#  ★왜 파일로 뺐나 (2026-08-23)
#    저장소를 외부 개발자와 공유하게 되면서 서버 주소를 코드에서 걷어냈다.
#    비밀번호는 아니지만 "어디를 두드리면 되는지"를 알려주는 정보다.
#    스크립트는 이 파일이 없으면 실행을 거부한다 — 조용히 엉뚱한 곳에 붙는 것보다 낫다.
# =============================================================================

# poc-app (k3s 노드) SSH 접속 대상
GGC_APP_HOST="ncloud@<poc-app 공인 IP>"

# poc-app 공인 IP — 외부 접속 검증·CORS 에 쓴다
GGC_PUBLIC_IP="<poc-app 공인 IP>"

# poc-app 사설 IP — 클러스터 내부 검증(LB)에 쓴다
GGC_LB_IP="<poc-app 사설 IP>"

# poc-db 사설 IP — 공인 IP 없음. poc-app 점프 경유로만 닿는다
GGC_DB_HOST="<poc-db 사설 IP>"

# SSH 키 경로
GGC_SSH_KEY="$HOME/.ssh/<배포키>"
